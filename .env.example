# Copy to .env for local runs, or add these in Vercel → Settings → Environment Variables. Never commit .env.

# Signs the session cookie. Any long random string: openssl rand -hex 32
SESSION_SECRET=
# Derives every team's password from its code. Keep it secret and keep it fixed: changing it changes every password.
LOGIN_SECRET=
# The organiser console's password (/admin).
ADMIN_PASSWORD=

# Postgres. Required on Vercel (the Neon integration in Vercel's Marketplace sets DATABASE_URL for you;
# POSTGRES_URL is read too). Leave empty locally to use an embedded Postgres kept in data/pglite.
DATABASE_URL=

# Local runs only: the port (default 3000), and 1 to mark the cookie Secure when serving over HTTPS
# (always on for Vercel).
PORT=
SECURE_COOKIES=
