# Copy to .env and fill in. Never commit .env.

# Signs the session cookie. Any long random string: openssl rand -hex 32
SESSION_SECRET=
# Derives every team's password from its code. Keep it secret and keep it fixed: changing it changes every password.
LOGIN_SECRET=
# The organiser console's password (/admin).
ADMIN_PASSWORD=

# The AI judge. The Anthropic SDK reads ANTHROPIC_API_KEY.
ANTHROPIC_API_KEY=
# Optional overrides (defaults: claude-opus-5-5 for Round 1, claude-sonnet-5-5 for Rounds 2 and 3).
JUDGE_MODEL_R1=
JUDGE_MODEL_R2=
JUDGE_MODEL_R3=
# low | medium | high (default medium)
JUDGE_EFFORT=
# Submissions judged at the same time (default 5).
JUDGE_CONCURRENCY=
# 1 = a fake judge that scores from a hash of the text, for rehearsals. Never on the real day.
JUDGE_FAKE=

# Where the SQLite file lives (default data/screening.sqlite) and the port (default 3000).
DATABASE_PATH=
PORT=
# 1 when served over HTTPS, so the session cookie is marked Secure.
SECURE_COOKIES=
